{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"types": [
			"node"
		],
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": true,
		"strictNullChecks": false,
		"skipLibCheck": true
	},
	"exclude": [
		"node_modules",
		".vscode-test",
		"out-test",
		"test"
	],
	"include": [
		"src/**/*"
	]
}
