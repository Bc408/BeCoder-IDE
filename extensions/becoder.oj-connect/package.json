{
	"name": "oj-connect",
	"publisher": "becoder",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"engines": {
		"vscode": "^1.130.0"
	},
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"activationEvents": [
		"onLanguage:c",
		"onLanguage:cpp",
		"onCommand:_becoder.ojConnect.importFromBrowser",
		"onCommand:_becoder.ojConnect.cancelBrowserImport",
		"onCommand:_becoder.ojConnect.importTarget",
		"onCommand:_becoder.ojConnect.captureImportedProblem"
	],
	"contributes": {
		"keybindings": [
			{
				"command": "becoder.ojConnect.submit",
				"key": "ctrl+alt+s",
				"when": "editorTextFocus && (editorLangId == c || editorLangId == cpp)"
			},
			{
				"command": "becoder.ojConnect.showProblem",
				"key": "ctrl+alt+p",
				"when": "editorTextFocus && (editorLangId == c || editorLangId == cpp)"
			}
		],
		"commands": [
			{
				"command": "becoder.ojConnect.submit",
				"title": "%submit%",
				"category": "OJ Connect"
			},
			{
				"command": "becoder.ojConnect.showProblem",
				"title": "%showProblem%",
				"category": "OJ Connect"
			},
			{
				"command": "becoder.ojConnect.continueQuery",
				"title": "%continueQuery%",
				"category": "OJ Connect"
			},
			{
				"command": "becoder.ojConnect.refreshAccounts",
				"title": "%refreshAccounts%",
				"category": "OJ Connect",
				"icon": "$(refresh)"
			}
		],
		"configuration": {
			"title": "%configurationTitle%",
			"properties": {
				"becoder.ojConnect.acmMode": {
					"title": "%becoder.ojConnect.acmMode.title%",
					"type": "boolean",
					"default": false,
					"scope": "application",
					"description": "%acmMode%"
				},
				"becoder.ojConnect.directories": {
					"title": "%becoder.ojConnect.directories.title%",
					"type": "object",
					"additionalProperties": false,
					"description": "%directories%",
					"default": {
						"luogu": "luogu",
						"codeforces": "codeforces",
						"atcoder": "atcoder",
						"lanqiao": "lanqiao",
						"nowcoder": "nowcoder"
					},
					"properties": {
						"luogu": {
							"type": "string",
							"description": "%luoguDirectory%"
						},
						"codeforces": {
							"type": "string",
							"description": "%codeforcesDirectory%"
						},
						"atcoder": {
							"type": "string",
							"description": "%atcoderDirectory%"
						},
						"lanqiao": {
							"type": "string",
							"description": "%lanqiaoDirectory%"
						},
						"nowcoder": {
							"type": "string",
							"description": "%nowcoderDirectory%"
						}
					}
				},
				"becoder.ojConnect.luogu.cCompiler": {
					"title": "%becoder.ojConnect.luogu.cCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^(?:\\d+(?::o2)?)?$",
					"description": "%luogu.cCompiler%"
				},
				"becoder.ojConnect.luogu.cppCompiler": {
					"title": "%becoder.ojConnect.luogu.cppCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^(?:\\d+(?::o2)?)?$",
					"description": "%luogu.cppCompiler%"
				},
				"becoder.ojConnect.atcoder.cCompiler": {
					"title": "%becoder.ojConnect.atcoder.cCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^(?:\\d*|catalogue:atcoder-c23-gcc)$",
					"description": "%atcoder.cCompiler%"
				},
				"becoder.ojConnect.atcoder.cppCompiler": {
					"title": "%becoder.ojConnect.atcoder.cppCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^\\d*$",
					"description": "%atcoder.cppCompiler%"
				},
				"becoder.ojConnect.atcoder.statementLanguage": {
					"title": "%becoder.ojConnect.atcoder.statementLanguage.title%",
					"enumItemLabels": ["%statementEnglish%","%statementJapanese%"],
					"type": "string",
					"enum": [
						"en",
						"ja"
					],
					"enumDescriptions": [
						"%statementEnglish%",
						"%statementJapanese%"
					],
					"default": "en",
					"scope": "application",
					"description": "%statementLanguage%"
				},
				"becoder.ojConnect.panelLocation": {
					"title": "%becoder.ojConnect.panelLocation.title%",
					"enumItemLabels": ["%settings.enum.auto%","%settings.enum.active%","%settings.enum.beside%","%settings.enum.one%","%settings.enum.two%","%settings.enum.three%"],
					"type": "string",
					"enum": [
						"auto",
						"active",
						"beside",
						"one",
						"two",
						"three"
					],
					"enumDescriptions": [
						"%panelAuto%",
						"%panelActive%",
						"%panelBeside%",
						"%panelOne%",
						"%panelTwo%",
						"%panelThree%"
					],
					"default": "auto",
					"scope": "window",
					"description": "%panelLocation%"
				},
				"becoder.ojConnect.codeforces.cCompiler": {
					"title": "%becoder.ojConnect.codeforces.cCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^\\d*$",
					"description": "%codeforces.cCompiler%"
				},
				"becoder.ojConnect.codeforces.cppCompiler": {
					"title": "%becoder.ojConnect.codeforces.cppCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^\\d*$",
					"description": "%codeforces.cppCompiler%"
				},
				"becoder.ojConnect.lanqiao.cCompiler": {
					"title": "%becoder.ojConnect.lanqiao.cCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^(?:c)?$",
					"description": "%lanqiao.cCompiler%"
				},
				"becoder.ojConnect.lanqiao.cppCompiler": {
					"title": "%becoder.ojConnect.lanqiao.cppCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^(?:cpp)?$",
					"description": "%lanqiao.cppCompiler%"
				},
				"becoder.ojConnect.nowcoder.cCompiler": {
					"title": "%becoder.ojConnect.nowcoder.cCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^\\d*$",
					"description": "%nowcoder.cCompiler%"
				},
				"becoder.ojConnect.nowcoder.cppCompiler": {
					"title": "%becoder.ojConnect.nowcoder.cppCompiler.title%",
					"type": "string",
					"default": "",
					"scope": "application",
					"pattern": "^\\d*$",
					"description": "%nowcoder.cppCompiler%"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "becoder-oj-connect",
					"title": "OJ Connect",
					"icon": "resources/oj-connect.svg"
				}
			]
		},
		"views": {
			"becoder-oj-connect": [
				{
					"id": "becoder.ojConnect.accounts",
					"name": "%accounts%",
					"type": "webview"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "becoder.ojConnect.refreshAccounts",
					"when": "view == becoder.ojConnect.accounts",
					"group": "navigation"
				}
			]
		}
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	},
	"scripts": {
		"typecheck": "node ../../node_modules/typescript/bin/tsc6 -p tsconfig.json --noEmit && node ../../node_modules/typescript/bin/tsc6 -p tsconfig.site-scripts.json && node ../../node_modules/typescript/bin/tsc6 -p tsconfig.webview.json && node ../../node_modules/typescript/bin/tsc6 -p tsconfig.content.json",
		"build": "node ../../node_modules/typescript/bin/tsc6 -p tsconfig.json && npm run compile-site-scripts && npm run compile-webview",
		"test": "npm run compile-site-scripts && node ../../node_modules/typescript/bin/tsc6 -p tsconfig.test.json && node --test out-test/test/*.test.js && node test/content-parser.mts",
		"vscode:prepublish": "npm run build",
		"compile-site-scripts": "node build-site-scripts.mts",
		"compile-webview": "node build-webview.mts",
		"test-render": "node test/render.mts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Bc408/BeCoder-IDE.git"
	},
	"devDependencies": {
		"@shikijs/langs": "3.23.0",
		"@types/hast": "3.0.4",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"esbuild": "0.28.2",
		"hast-util-from-html": "2.0.2",
		"jsdom": "26.1.0",
		"katex": "0.18.10",
		"property-information": "7.2.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"rehype-autolink-headings": "7.1.0",
		"rehype-katex": "7.0.1",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"rehype-slug": "6.0.0",
		"remark-breaks": "4.0.0",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"remark-smartypants": "3.0.3",
		"unified": "11.0.5",
		"unist-util-visit": "5.2.0",
		"vfile": "6.0.3"
	},
	"overrides": {
		"katex": "$katex"
	}
}
