{
	"name": "runner",
	"displayName": "BeCoder Runner",
	"description": "Compile and run C/C++ files with BeCoder's integrated toolchain.",
	"version": "0.2.0",
	"publisher": "becoder",
	"license": "GPL-3.0",
	"engines": { "vscode": "^1.130.0" },
	"main": "./dist/extension.js",
	"categories": ["Programming Languages", "Other"],
	"activationEvents": ["onLanguage:c", "onLanguage:cpp"],
	"contributes": {
		"commands": [
			{ "command": "becoder.runner.compile", "title": "BeCoder: Compile", "icon": "$(tools)" },
			{ "command": "becoder.runner.run", "title": "BeCoder: Run", "icon": "$(play)" },
			{ "command": "becoder.runner.runWithFile", "title": "BeCoder: Run With Input", "icon": "$(file)" }
		],
		"menus": {
			"editor/title": [
				{ "command": "becoder.runner.run", "when": "editorLangId == c || editorLangId == cpp", "group": "navigation@0" },
				{ "command": "becoder.runner.runWithFile", "when": "editorLangId == c || editorLangId == cpp", "group": "navigation@1" }
			],
			"commandPalette": [
				{ "command": "becoder.runner.compile", "when": "editorLangId == c || editorLangId == cpp" },
				{ "command": "becoder.runner.run", "when": "editorLangId == c || editorLangId == cpp" },
				{ "command": "becoder.runner.runWithFile", "when": "editorLangId == c || editorLangId == cpp" }
			]
		},
		"keybindings": [
			{ "key": "f6", "command": "becoder.runner.run", "when": "editorLangId == c || editorLangId == cpp" },
			{ "key": "shift+f6", "command": "becoder.runner.runWithFile", "when": "editorLangId == c || editorLangId == cpp" }
		],
		"configuration": {
			"title": "BeCoder Runner",
			"properties": {
				"becoder.runner.cStandard": { "type": "string", "enum": ["c11", "c17", "c23"], "default": "c17", "description": "C standard used by BeCoder Runner." },
				"becoder.runner.cppStandard": { "type": "string", "enum": ["c++11", "c++14", "c++17", "c++20", "c++23"], "default": "c++20", "description": "C++ standard used by BeCoder Runner." },
				"becoder.runner.cppFlags": { "type": "array", "items": { "type": "string" }, "default": ["-O2", "-Wall", "-DDEBUG"], "description": "Additional C++ compiler flags used by BeCoder Runner." },
				"becoder.runner.cFlags": { "type": "array", "items": { "type": "string" }, "default": ["-O2", "-Wall", "-DDEBUG"], "description": "Additional C compiler flags used by BeCoder Runner." },
				"becoder.runner.cleanupExecutable": { "type": "boolean", "default": true, "description": "Delete the source-adjacent executable after the program exits." }
			}
		}
	},
	"scripts": {
		"compile": "webpack",
		"package": "webpack --mode production --devtool hidden-source-map",
		"vscode:prepublish": "npm run package"
	},
	"dependencies": {
		"find-process": "^2.0.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.109.0",
		"typescript": "^5.9.3",
		"webpack": "^5.99.9",
		"webpack-cli": "^6.0.1",
		"ts-loader": "^9.5.2"
	}
}
