{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true,
		"skipLibCheck": true,
		"typeRoots": [
			"./node_modules/@types",
			"../../node_modules/@types"
		],
		"types": [
			"node",
			"react",
			"react-dom"
		]
	},
	"include": [
		"src/**/*.ts",
		"webview/**/*.tsx",
		"test/**/*.ts",
		"../../src/vscode-dts/vscode.d.ts"
	]
}
