{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "..",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2024", "DOM"],
		"paths": {
			"hast": ["./node_modules/@types/hast"],
			"mdast": ["./node_modules/@types/mdast"],
			"unist": ["./node_modules/@types/unist"],
			"*": ["./node_modules/*", "../../node_modules/*"]
		}
	},
	"include": ["../becoder.shared/content/**/*.ts", "../becoder.shared/build/**/*.mts", "test/content-parser.mts"]
}
