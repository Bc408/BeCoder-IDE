{
	"name": "runner",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.3.0",
	"publisher": "becoder",
	"license": "GPL-3.0",
	"engines": { "vscode": "^1.130.0" },
	"main": "./dist/extension.js",
	"categories": ["Programming Languages", "Other"],
	"activationEvents": ["onLanguage:c", "onLanguage:cpp", "onTerminalProfile:becoder.runner"],
	"extensionDependencies": ["becoder.becoder-setup"],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "BeCoder Runner compiles and executes workspace source code."
		}
	},
	"contributes": {
		"configurationDefaults": {
			"terminal.integrated.defaultProfile.windows": "BeCoder Runner"
		},
		"terminal": {
			"profiles": [
				{ "id": "becoder.runner", "title": "BeCoder Runner", "icon": "terminal" }
			]
		},
		"commands": [
			{ "command": "becoder.runner.openPanel", "title": "%command.openPanel%", "icon": "$(terminal)" },
			{ "command": "becoder.runner.run", "title": "%command.run%", "icon": "$(play)" },
			{ "command": "becoder.runner.runWithInput", "title": "%command.runWithInput%", "icon": "$(file)" }
		],
		"menus": {
			"editor/title": [
				{ "command": "becoder.runner.run", "when": "editorLangId == c || editorLangId == cpp", "group": "navigation@0" },
				{ "command": "becoder.runner.runWithInput", "when": "editorLangId == c || editorLangId == cpp", "group": "navigation@1" }
			],
			"commandPalette": [
				{ "command": "becoder.runner.openPanel" },
				{ "command": "becoder.runner.run", "when": "editorLangId == c || editorLangId == cpp" },
				{ "command": "becoder.runner.runWithInput", "when": "editorLangId == c || editorLangId == cpp" }
			]
		},
		"keybindings": [
			{ "key": "ctrl+`", "command": "becoder.runner.openPanel" },
			{ "key": "f6", "command": "becoder.runner.run", "when": "editorLangId == c || editorLangId == cpp" },
			{ "key": "shift+f6", "command": "becoder.runner.runWithInput", "when": "editorLangId == c || editorLangId == cpp" }
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"becoder.runner.cStandard": { "type": "string", "enum": ["c11", "c17", "c23"], "default": "c17", "description": "%configuration.cStandard%" },
				"becoder.runner.cppStandard": { "type": "string", "enum": ["c++11", "c++14", "c++17", "c++20", "c++23"], "default": "c++20", "description": "%configuration.cppStandard%" },
				"becoder.runner.cppFlags": { "type": "array", "items": { "type": "string" }, "default": [], "description": "%configuration.cppFlags%" },
				"becoder.runner.cFlags": { "type": "array", "items": { "type": "string" }, "default": [], "description": "%configuration.cFlags%" }
			}
		}
	},
	"scripts": {
		"compile": "webpack",
		"package": "webpack --mode production --devtool hidden-source-map",
		"test": "node -e \"require('fs').rmSync('out-test', { recursive: true, force: true })\" && node ../../node_modules/typescript/bin/tsc6 -p ./tsconfig.test.json && node --test out-test/test/*.test.js",
		"vscode:prepublish": "npm run package"
	},
	"devDependencies": {
		"@types/vscode": "^1.109.0",
		"typescript": "^5.9.3",
		"webpack": "^5.99.9",
		"webpack-cli": "^6.0.1",
		"ts-loader": "^9.5.2"
	}
}
