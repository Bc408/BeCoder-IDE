{
	"name": "becoder-setup",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "becoder",
	"license": "MIT",
	"engines": {
		"vscode": "^1.129.0"
	},
	"categories": ["Other"],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": ["*", "onCommand:becoder.openSettings", "onCommand:becoder.configureCppSnippets", "onCommand:becoder.configureAutoFormat", "onCommand:becoder.openToolchainDiagnostics"],
	"main": "./out/extension.js",
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true }); require('fs').rmSync('out-test', { recursive: true, force: true })\"",
		"compile": "npm run clean && node ../../node_modules/typescript/bin/tsc6 -p ./",
		"test": "node -e \"require('fs').rmSync('out-test', { recursive: true, force: true })\" && node ../../node_modules/typescript/bin/tsc6 -p ./tsconfig.test.json && node --test out-test/test/*.test.js",
		"vscode:prepublish": "npm run compile"
	},
	"contributes": {
		"configurationDefaults": {
			"editor.unicodeHighlight.nonBasicASCII": false,
			"editor.unicodeHighlight.ambiguousCharacters": false,
			"editor.unicodeHighlight.invisibleCharacters": true,
			"editor.fontLigatures": false,
			"editor.cursorSmoothCaretAnimation": "on",
			"editor.smoothScrolling": true,
			"workbench.list.smoothScrolling": true,
			"terminal.integrated.smoothScrolling": true,
			"editor.cursorBlinking": "smooth",
			"editor.fontSize": 14,
			"files.autoSave": "onFocusChange",
			"editor.formatOnSave": false,
			"editor.formatOnPaste": false,
			"editor.mouseWheelZoom": true,
			"window.systemColorTheme": "auto",
			"window.titleBarStyle": "custom",
			"workbench.iconTheme": "vs-seti",
			"workbench.startupEditor": "welcomePage",
			"becoder.runner.cppFlags": ["-O2", "-Wall", "-DDEBUG"],
			"becoder.runner.cFlags": ["-O2", "-Wall", "-DDEBUG"]
		},
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"becoder.displayLanguage": {
					"type": "string",
					"default": "zh-cn",
					"enum": ["zh-cn", "en"],
					"enumItemLabels": ["%configuration.displayLanguage.zhCn%", "%configuration.displayLanguage.en%"],
					"scope": "application",
					"order": 0,
					"title": "%configuration.displayLanguage.title%",
					"description": "%configuration.displayLanguage.description%"
				},
				"becoder.newFile.defaultLanguage": {
					"type": "string",
					"default": "cpp",
					"scope": "window",
					"title": "%configuration.newFileDefaultLanguage.title%",
					"description": "%configuration.newFileDefaultLanguage%"
				},
				"becoder.welcome.onlineJudgeSites": {
					"type": "object",
					"additionalProperties": { "type": "string", "pattern": "^https?://[^\\s]+$" },
					"default": {
						"Codeforces": "https://codeforces.com/",
						"AtCoder": "https://atcoder.jp/",
						"洛谷": "https://www.luogu.com.cn/",
						"蓝桥杯": "https://www.lanqiao.cn/",
						"牛客": "https://ac.nowcoder.com/",
						"HDOJ": "https://acm.hdu.edu.cn/",
						"CSES": "https://cses.fi/",
						"SPOJ": "https://www.spoj.com/",
						"AcWing": "https://www.acwing.com/",
						"LibreOJ": "https://loj.ac/",
						"LibreOJ Archive": "https://libreoj.github.io/",
						"DMOJ": "https://dmoj.ca/",
						"MOI Arena": "https://arena.moi/",
						"Le Quy Don Online Judge": "https://lqdoj.edu.vn/",
						"VNOI Online Judge": "https://oj.vnoi.info/",
						"A.Y. Jackson Online Judge": "https://ayjcoding.club/"
					},
					"scope": "application",
					"order": 3,
					"title": "%configuration.welcome.onlineJudgeSites.title%",
					"markdownDescription": "%configuration.welcome.onlineJudgeSites.description%"
				},
				"becoder.welcome.onlineJudges": {
					"type": "array",
					"items": { "type": "string" },
					"uniqueItems": true,
					"default": ["Codeforces", "AtCoder", "洛谷", "蓝桥杯", "牛客", "HDOJ"],
					"scope": "application",
					"order": 4,
					"title": "%configuration.welcome.onlineJudges.title%",
					"markdownDescription": "%configuration.welcome.onlineJudges.description%"
				},
				"becoder.inlayHints.enabled": {
					"type": "boolean",
					"default": false,
					"scope": "window",
					"order": 2,
					"title": "%configuration.inlayHints.title%",
					"description": "%configuration.inlayHints.description%"
				}
			}
		},
		"commands": [
			{
				"command": "becoder.openSettings",
				"title": "%command.openSettings%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "becoder.configureCppSnippets",
				"title": "%command.configureCppSnippets%"
			},
			{
				"command": "becoder.configureAutoFormat",
				"title": "%command.configureAutoFormat%"
			},
			{
				"command": "becoder.openToolchainDiagnostics",
				"title": "%command.openToolchainDiagnostics%",
				"icon": "$(pulse)"
			},
			{
				"command": "becoder.showAllFiles",
				"title": "%command.showAllFiles%",
				"icon": "$(eye)"
			},
			{
				"command": "becoder.hideSetupFiles",
				"title": "%command.hideSetupFiles%",
				"icon": "$(eye-closed)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "becoder.showAllFiles",
					"when": "view == workbench.explorer.fileView && becoder.filesHiddenByBeCoder",
					"group": "navigation@10"
				},
				{
					"command": "becoder.hideSetupFiles",
					"when": "view == workbench.explorer.fileView && !becoder.filesHiddenByBeCoder",
					"group": "navigation@10"
				}
			]
		}
	}
}
