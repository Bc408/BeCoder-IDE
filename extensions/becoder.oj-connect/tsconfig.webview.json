{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"property-information": ["./node_modules/property-information"],
			"hast": ["./node_modules/@types/hast"]
		},
		"rootDir": "..",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"types": [],
		"jsx": "react",
		"esModuleInterop": true,
		"typeRoots": [
			"./node_modules/@types",
			"../../node_modules/@types"
		]
	},
	"include": [
		"../becoder.shared/browser/content/assets.d.ts",
		"webview/**/*",
		"src/views/model.ts",
		"../../src/typings/becoder-oj-connect.d.ts"
	]
}
