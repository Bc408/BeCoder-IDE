{
	"name": "beacon",
	"displayName": "Beacon",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "becoder",
	"license": "MIT",
	"engines": {
		"vscode": "^1.130.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.cjs",
	"l10n": "./l10n",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"contributes": {
		"commands": [
			{
				"command": "becoder.beacon.open",
				"title": "%open%",
				"category": "Beacon",
				"icon": {
					"light": "resources/beacon-light.svg",
					"dark": "resources/beacon.svg"
				}
			},
			{
				"command": "becoder.beacon.settings",
				"title": "%command.settings%",
				"category": "Beacon",
				"icon": "$(gear)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "becoder.beacon.open",
					"when": "true",
					"group": "navigation@99"
				}
			],
			"commandPalette": [
				{
					"command": "becoder.beacon.open"
				},
				{
					"command": "becoder.beacon.settings"
				}
			]
		},
		"viewsContainers": {
			"secondarySidebar": [
				{
					"id": "becoder-beacon",
					"title": "Beacon",
					"icon": "resources/beacon.svg"
				}
			]
		},
		"views": {
			"becoder-beacon": [
				{
					"type": "webview",
					"id": "becoder.beacon.chat",
					"name": "Beacon"
				}
			]
		},
		"configuration": {
			"title": "Beacon",
			"properties": {
				"beacon.filePermission": {
					"type": "string",
					"enum": [
						"none",
						"workspace",
						"computer"
					],
					"enumDescriptions": [
						"%permissions.none%",
						"%permissions.workspace%",
						"%permissions.computer%"
					],
					"default": "none",
					"scope": "application",
					"description": "%permissions.description%"
				},
				"beacon.webEnabled": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "%settings.webEnabled%"
				},
				"beacon.modelConfiguration": {
					"type": "object",
					"default": {
						"providers": {
							"deepseek": { "baseURL": "https://api.deepseek.com", "models": [] },
							"bailian": { "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1", "models": [] },
							"moonshot": { "baseURL": "https://api.moonshot.cn/v1", "models": [] },
							"ollama": { "baseURL": "http://localhost:11434/v1", "models": [] }
						}
					},
					"scope": "application",
					"description": "%settings.modelConfiguration%",
					"additionalProperties": false,
					"properties": {
						"selection": {
							"type": "object"
						},
						"providers": {
							"type": "object"
						}
					}
				}
			}
		}
	},
	"scripts": {
		"typecheck": "node ../../node_modules/typescript/bin/tsc6 -p tsconfig.json",
		"build": "node build.mjs",
		"test": "node --test dist-test/session.test.cjs dist-test/files.test.cjs dist-test/models.test.cjs dist-test/web.test.cjs dist-test/attachments.test.cjs dist-test/settings.test.cjs",
		"vscode:prepublish": "npm run typecheck && npm run build",
		"lint": "node ../../node_modules/eslint/bin/eslint.js --config eslint.config.mjs src webview test build.mjs --max-warnings 0",
		"test-render": "node test/render.mjs"
	},
	"devDependencies": {
		"@ai-sdk/deepseek": "3.0.50",
		"@ai-sdk/openai-compatible": "3.0.55",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"ai": "7.0.111",
		"esbuild": "0.28.2",
		"katex": "0.16.47",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"rehype-katex": "7.0.1",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"shiki": "3.23.0",
		"use-stick-to-bottom": "1.1.6"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Bc408/BeCoder-IDE.git"
	}
}
